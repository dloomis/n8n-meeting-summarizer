    {
      "parameters": {
        "jsCode": "    return items.map(item => {\n      const summary = $input.first().json.output || ''; // Adjust field if different\n      const audioFileName = $('Workflow Data').first().json.obsidianNoteRootName + '.m4a';\n      const updatedSummary = summary.replace(/audio\\.m4a/g, audioFileName);\n      return {\n          json: {\n              output: updatedSummary // Update the field\n          }\n      };\n  });"
